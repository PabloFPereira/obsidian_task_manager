{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "inlineSourceMap": false,
    "inlineSources": false,
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "tests",
    "node_modules"
  ]
}
